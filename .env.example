# ========================================================
# CONFIGURACIÓN DE ENTORNO — CASINO OASIS
# ========================================================
# Instrucciones:
# 1. Copia este archivo y renómbralo como '.env'
# 2. Configura la URL de tu servidor de base de datos o API.
# 3. El archivo '.env' está protegido por .gitignore y nunca se subirá a GitHub.
# ========================================================

# URL de la API del servidor de base de datos
# Puedes usar el servidor incluido ejecutando `npm run server` (http://localhost:4000/api)
# o la URL de tu servidor externo / base de datos en la nube:
VITE_DATABASE_URL=http://localhost:4000/api

# Correo del Administrador con acceso al Panel de Control (/admin) y modo mantenimiento
VITE_ADMIN_EMAIL=admin@oasis.com
